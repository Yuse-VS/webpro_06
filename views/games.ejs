<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>ゲーム一覧</title>
</head>
<body>
  <h2>ゲームと制作企業の一覧</h2>
  <table>
    <tr><th>ID</th><th>ゲーム名</th><th>制作企業</th></tr>
      <% for( let row of data ) { %>
        <tr><td><%= row.id %></td>
        <td><%= row.title %></td>
        <td><%= row.company %></td></tr>
      <% } %>
  </table>
</body>
</html>
